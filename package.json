    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
