# Copy this file to .env and add your personal API keys.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Python mission API used by the text-only planetary analog search page.
MISSION_BACKEND_URL=http://127.0.0.1:8000

# Optional: a PetDB ROCK MODE / Whole Rock export with modal OL, PLAG, OPX, CPX fields.
EARTH_MINERAL_DATA_FILE=
# Optional: an already-generated Earth mineral-match GeoJSON.
EARTH_MINERAL_MATCH_FILE=
