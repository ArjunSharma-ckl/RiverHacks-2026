# Copy to .env.local for development. Everything here is optional.
#
# No key needed: NASA GIBS imagery, NASA EONET events, NASA POWER surface data,
# NASA Image and Video Library.

# api.nasa.gov key, used for DONKI space weather and APOD.
# Free at https://api.nasa.gov - falls back to DEMO_KEY (heavily rate limited).
NASA_API_KEY=

# Cesium ion token for world terrain. Read at BUILD time, so it must be set in
# the build environment before the build runs. https://ion.cesium.com
VITE_CESIUM_ION_ACCESS_TOKEN=

# Optional extras.
SERPAPI_KEY= 
FIRMS_MAP_KEY=

# Server-side ArcGIS World Imagery access
ARCGIS_API_KEY=

# Server-side Cesium token for the terrain endpoint
CESIUM_ION_ACCESS_TOKEN=
# GroundTruth AI uses SERPAPI_KEY above for Scholar, Search and News. Missing keys return an unavailable state.

# Planetary analog search. The web server proxies /api/earth-analogs,
# /api/mars-analogs and /api/earth-analog-attribute to this Python API.
# Start it with `python -m backend.server`.
MISSION_BACKEND_URL=http://127.0.0.1:8000

# Optional: Gemini key the Python API uses to estimate image-derived surface roughness.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: a PetDB ROCK MODE / Whole Rock export with modal OL, PLAG, OPX, CPX fields.
EARTH_MINERAL_DATA_FILE=
# Optional: an already-generated Earth mineral-match GeoJSON.
EARTH_MINERAL_MATCH_FILE=
