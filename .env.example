# Copy to .env.local for development. Everything here is optional.
#
# No key needed: NASA GIBS imagery, NASA EONET events, NASA POWER surface data,
# NASA Image and Video Library.

# api.nasa.gov key, used for DONKI space weather and APOD.
# Free at https://api.nasa.gov - falls back to DEMO_KEY (heavily rate limited).
NASA_API_KEY=

# Cesium ion token for world terrain. Read at BUILD time, so it must be set in
# the Render dashboard before the build runs. https://ion.cesium.com
VITE_CESIUM_ION_ACCESS_TOKEN=

# Optional extras.
SERPAPI_KEY=
FIRMS_MAP_KEY=

# Server-side ArcGIS World Imagery access
ARCGIS_API_KEY=
