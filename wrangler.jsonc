{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riverhacks-2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
